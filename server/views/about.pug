extends modal_layout
block modal_extra_scripts
    script.
        function handleInfoMessage() {
            if ("#{infoMessage}".length > 0) {
                $('#info_message_content').text("#{infoMessage}");
            } else {
                $('#info_message_header').hide();
                $('#info_message_content').hide();
            }
        }

block modal_title
    | À propos
block modal_body
    h6 Pourquoi
    p "Just drop it" vous permet d'envoyer simplement et instantanément un fichier à un ami, quelle que soit votre configuration réseau (VPN, etc...).
    p Nous pensions que ce type d'outil manquait dans notre environnement de travail, alors nous avons essayé d'en mettre un en place. Heureusement pour nous, des outils comme node.js, socket.IO et socket.IO-stream ont rendu la mise en place et le fonctionnement assez simple.
    h6 Dependences
    p node.js + express + socket.IO + socket.IO-stream + boosted(bootstrap)...
    h6 Auteurs
    ul
        li Marvideo (Host)
        li Arnaud Ruffin (Developpeur chez Orange)
        li Benjamin Einaudi (Developpeur chez Orange)
    h6#info_message_header Info
    p#info_message_content
    h6 Contact
    p Pour toute question, suggestion ou même contribution, n'hésitez pas à visiter notre projet sur&nbsp;
        a(title="github" href="https://github.com/Marvideo2009/just-drop-it") GitHub
